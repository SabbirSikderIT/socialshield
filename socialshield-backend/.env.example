# ---- Social Shield configuration (keep this file private!) ----
SECRET_KEY=change-me

# PostgreSQL connection. Replace YOUR_PASSWORD with your postgres user's password.
# The database is created automatically if it doesn't exist.
# If PostgreSQL can't be reached the app falls back to SQLite (instance/social_shield.db).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/social_shield

# Gmail SMTP for password-recovery and welcome emails.
# MAIL_USERNAME must be the Gmail address that owns the app password below.
MAIL_USERNAME=
MAIL_PASSWORD=your-16-char-app-password
MAIL_SENDER_NAME=Social Shield

# Google Gemini (chatbot). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Footer credit shown on every page
CREDIT_TEXT=Designed & developed with 💜 by Team Social Shield · UIU DBMS Project

# Show the reset code on screen when email can't be sent (turn off in production)
DEV_SHOW_RESET_CODE=1
